# Supabase Configuration (Required)
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Gemini API Key (Optional - enables AI features, server-side only)
# Get this from https://aistudio.google.com/apikey
# This key is used by the /api/gemini serverless function; it is never exposed to the client.
GEMINI_API_KEY=your-gemini-api-key

# API Base URL (Optional - for Capacitor native builds)
# Set this to your deployed Vercel URL when building native apps (e.g., https://ai-pill-reminder.vercel.app)
# Leave empty for web builds (defaults to same-origin)
VITE_API_BASE_URL=
